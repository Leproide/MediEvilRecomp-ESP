@@ -30,6 +30,16 @@ public static class ShaderMaterials
 
     public static bool Any { get; private set; }
 
+    // selettore dei materiali (MediEvilRecomp ITA): con PickEnabled RecompOne scrive la texture di ogni
+    // pixel della scena e mette in Picked quella sotto il centro dello schermo (tpage, clut, u, v)
+    public static volatile bool PickEnabled;
+    public static (int TPage, int Clut, int U, int V)? Picked;
