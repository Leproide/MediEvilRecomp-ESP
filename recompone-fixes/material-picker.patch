--- a/RecompOne.Runtime/Gpu/Backends/Common/GlCore.cs
+++ b/RecompOne.Runtime/Gpu/Backends/Common/GlCore.cs
@@ -1224,7 +1224,7 @@ public sealed class GlCore : IGpuBackend
             }
         }
 
-        if (_kDepth && rt != null && !_legacy && !_kTransparent && _uGbuffer >= 0 && PostFx.Active && SlangChain.GbufferWanted)
+        if (_kDepth && rt != null && !_legacy && !_kTransparent && _uGbuffer >= 0 && PostFx.Active && (SlangChain.GbufferWanted || ShaderMaterials.PickEnabled))
             DrawGbuffer(rt, surface);
 
         if (_kLayer && rt != null && !_legacy) DrawLayer(rt);
@@ -1535,7 +1535,8 @@ public sealed class GlCore : IGpuBackend
         _gl.DepthMask(false);
         _gl.Disable(EnableCap.StencilTest);
         _gl.Disable(EnableCap.Blend);
-        for (var i = 0; i < 2; i++)
+        var targets = ShaderMaterials.PickEnabled ? 3 : 2;
+        for (var i = 0; i < targets; i++)
         {
             rt.PrepareGbuffer(_gl, _depthScene, i);
             _gl.Enable(EnableCap.ScissorTest);
@@ -1600,6 +1601,19 @@ public sealed class GlCore : IGpuBackend
             _gl.DrawArrays(PrimitiveType.TriangleStrip, 0, 4);
         }
         chain.SetGbuffer(_gbufPresentTex[0], _gbufPresentTex[1], fbW, fbH);
+
+        // selettore dei materiali: texture sotto il punto scelto (ShaderMaterials.PickX/PickY)
+        if (ShaderMaterials.PickEnabled && src.GbufTex[2] != 0)
+        {
+            var fy = ShaderMaterials.PickFlipY ? 1f - ShaderMaterials.PickY : ShaderMaterials.PickY;
+            var px = (dispX - src.X + Math.Clamp((int)(w1x * ShaderMaterials.PickX), 0, w1x - 1)) * GlVram.Scale;
+            var py = (dispY - src.Y + Math.Clamp((int)(h1x * fy), 0, h1x - 1)) * GlVram.Scale;
+            var texel = new ushort[4];
+            _gl.BindFramebuffer(FramebufferTarget.Framebuffer, src.GbufFbo[2]);
+            fixed (ushort* p = texel)
+                _gl.ReadPixels(px, py, 1, 1, PixelFormat.Rgba, PixelType.UnsignedShort, p);
+            ShaderMaterials.Picked = texel[3] == 0 ? null : (texel[0], texel[1], texel[2], texel[3] - 1);
+        }
     }
 
     private void ResetLayer(GlDisplayRt rt)
