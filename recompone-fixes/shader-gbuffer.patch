@@ -134,8 +140,63 @@ public sealed class GlDisplayRt
         _uiScene = scene;
     }
     
+    public unsafe void PrepareGbuffer(GL gl, long scene, int index)
+    {
+        if (GbufTex[0] == 0)
+        {
+            gl.GetInteger(GetPName.TextureBinding2D, out var previous);
+            for (var i = 0; i < 2; i++)
+            {
+                GbufTex[i] = gl.GenTexture();
+                gl.BindTexture(TextureTarget.Texture2D, GbufTex[i]);
+                gl.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureMinFilter, (int)GLEnum.Nearest);
+                gl.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureMagFilter, (int)GLEnum.Nearest);
+                gl.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureWrapS, (int)GLEnum.ClampToEdge);
+                gl.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureWrapT, (int)GLEnum.ClampToEdge);
+                gl.TexImage2D(TextureTarget.Texture2D, 0, InternalFormat.Rgba8, (uint)TexW, (uint)TexH, 0,
+                    PixelFormat.Rgba, PixelType.UnsignedByte, (void*)0);
+                GbufFbo[i] = gl.GenFramebuffer();
+                gl.BindFramebuffer(FramebufferTarget.Framebuffer, GbufFbo[i]);
+                gl.FramebufferTexture2D(FramebufferTarget.Framebuffer, FramebufferAttachment.ColorAttachment0,
+                    TextureTarget.Texture2D, GbufTex[i], 0);
+                _gbufDepth[i] = 0;
+            }
+            gl.BindTexture(TextureTarget.Texture2D, (uint)previous);
+            _gbufScene = -1;
+        }
+
+        if (_gbufScene != scene)
+        {
+            gl.Disable(EnableCap.ScissorTest);
+            gl.ColorMask(true, true, true, true);
+            gl.ClearColor(0f, 0f, 0f, 0f);
+            for (var i = 0; i < 2; i++)
+            {
+                gl.BindFramebuffer(FramebufferTarget.Framebuffer, GbufFbo[i]);
+                gl.Clear(ClearBufferMask.ColorBufferBit);
+            }
+            _gbufScene = scene;
+            gl.Enable(EnableCap.ScissorTest);
+        }
+
+        gl.BindFramebuffer(FramebufferTarget.Framebuffer, GbufFbo[index]);
+        if (_depth != 0 && _gbufDepth[index] != _depth)
+        {
+            gl.FramebufferTexture2D(FramebufferTarget.Framebuffer, FramebufferAttachment.DepthStencilAttachment,
+                TextureTarget.Texture2D, _depth, 0);
+            _gbufDepth[index] = _depth;
+        }
+    }
+
     public void Destroy(GL gl)
     {
+        for (var i = 0; i < 2; i++)
+        {
+            if (GbufFbo[i] != 0) gl.DeleteFramebuffer(GbufFbo[i]);
+            if (GbufTex[i] != 0) gl.DeleteTexture(GbufTex[i]);
+            GbufFbo[i] = GbufTex[i] = _gbufDepth[i] = 0;
+        }
+        _gbufScene = -1;
         if (_depth != 0) gl.DeleteTexture(_depth);
         _depth = 0;
         _depthScene = -1;
