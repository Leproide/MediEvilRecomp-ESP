+            _gl.BindFramebuffer(FramebufferTarget.Framebuffer, _gbufPresentFbo[i]);
+            _gl.Viewport(0, 0, (uint)fbW, (uint)fbH);
+            _gl.ActiveTexture(TextureUnit.Texture0);
+            _gl.BindTexture(TextureTarget.Texture2D, src.GbufTex[i]);
+            _gl.DrawArrays(PrimitiveType.TriangleStrip, 0, 4);
