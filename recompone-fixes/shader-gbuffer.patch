+            if (_gbufPresentTex[i] == 0)
+            {
+                _gbufPresentTex[i] = _gl.GenTexture();
+                _gbufPresentFbo[i] = _gl.GenFramebuffer();
+                _gbufPresentW = -1;
+            }
+        }
+
+        if (_gbufPresentW != fbW || _gbufPresentH != fbH)
+        {
