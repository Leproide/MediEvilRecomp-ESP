+        _gl.Uniform2(_uLayerOrigin, (float)(dispX - src.X), dispY - src.Y);
+        _gl.Uniform2(_uLayerSize, (float)w1x, h1x);
+        _gl.Uniform2(_uLayerTexSize, (float)src.Wide1x, src.H);
+        for (var i = 0; i < 2; i++)
