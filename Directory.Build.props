<Project>
  <!--
    MediEvilRecomp - cartelle di uscita per versione.
    Con -p:Lingua=es il gioco (e RecompOne, che e' dentro questa cartella) compila in
    bin-es/ e obj-es/, cosi' le build italiana e spagnola non si sovrascrivono.
    Ogni progetto ignora i file dell'altra versione (es. AssemblyInfo generati in obj-es/).
    Author: https://github.com/Leproide - GPL-3.0-or-later
  -->
  <PropertyGroup Condition="'$(Lingua)' == 'es'">
    <BaseOutputPath>bin-es/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj-es/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;bin-fr/**;obj-fr/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- Con -p:Lingua=fr la PAL francese (SCES-01492): bin-fr/ e obj-fr/ -->
  <PropertyGroup Condition="'$(Lingua)' == 'fr'">
    <BaseOutputPath>bin-fr/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj-fr/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;bin-es/**;obj-es/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Lingua)' != 'es' and '$(Lingua)' != 'fr'">
    <DefaultItemExcludes>$(DefaultItemExcludes);bin-es/**;obj-es/**;bin-fr/**;obj-fr/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
