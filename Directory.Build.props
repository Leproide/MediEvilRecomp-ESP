<Project>
  <!--
    MediEvilRecomp - cartelle di uscita per versione.
    Con -p:Lingua=es il gioco (e RecompOne, che e' dentro questa cartella) compila in
    bin-es/ e obj-es/, cosi' le build italiana e spagnola non si sovrascrivono.
    Ogni progetto ignora i file dell'altra versione (es. AssemblyInfo generati in obj-es/).
    Author: https://github.com/Leproide - GPL-3.0-or-later
  -->
  <!-- -p:Lingua=es|fr|de|en: bin-<lingua>/ e obj-<lingua>/ (spagnola, francese, tedesca, inglese) -->
  <PropertyGroup Condition="'$(Lingua)' == 'es' or '$(Lingua)' == 'fr' or '$(Lingua)' == 'de' or '$(Lingua)' == 'en'">
    <BaseOutputPath>bin-$(Lingua)/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj-$(Lingua)/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <!-- ogni build ignora le cartelle di uscita di tutte le versioni -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;bin-es/**;obj-es/**;bin-fr/**;obj-fr/**;bin-de/**;obj-de/**;bin-en/**;obj-en/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
