<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Codice originale di MediEvilRecomp (BlackLabelHQ), senza licenza esplicita: i diritti
    restano ai suoi autori; questo file NON e' rilasciato sotto GPL-3.0.
    Modifica del fork (https://github.com/Leproide), scelta della versione: senza proprieta'
    (o -p:Lingua=it) compila la PAL italiana SCES-01494 (config/MediEvil.json, generated/);
    con -p:Lingua=es la PAL spagnola SCES-01495 (config/es/MediEvil.json, generated-es/,
    simbolo LINGUA_ES, uscita in bin-es/ e obj-es/, vedi Directory.Build.props).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>medievil</AssemblyName>
    <NoWarn>0162</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);RecompOne/**;BACKUP_Dipendenze/**</DefaultItemExcludes>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
     <ApplicationIcon>assets/icon/MediEvilRecomp.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- codice generato della versione scelta -->
  <PropertyGroup Condition="'$(Lingua)' == 'es'">
    <DefineConstants>$(DefineConstants);LINGUA_ES</DefineConstants>
    <DefaultItemExcludes>$(DefaultItemExcludes);generated/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Lingua)' != 'es'">
    <DefaultItemExcludes>$(DefaultItemExcludes);generated-es/**</DefaultItemExcludes>
  </PropertyGroup>
  <Target Name="CheckLingua" BeforeTargets="BeforeBuild"
          Condition="'$(Lingua)' != '' and '$(Lingua)' != 'it' and '$(Lingua)' != 'es'">
    <Error Text="Lingua='$(Lingua)' non valida: usa it (predefinita) oppure es." />
  </Target>
  <Target Name="CheckGenerated" BeforeTargets="BeforeBuild">
    <Error Condition="'$(Lingua)' == 'es' and !Exists('generated-es')"
           Text="Manca generated-es/: genera prima il codice con dotnet run --project RecompOne/RecompOne.Recompiler config/es/MediEvil.json" />
  </Target>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/languages.json" />
     <EmbeddedResource Include="assets/icon/*.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="RecompOne/RecompOne.Runtime/RecompOne.Runtime.csproj" UndefineProperties="OutputType" />
  </ItemGroup>
</Project>
